# Absolute origin, no trailing slash. Drives metadataBase, canonical URLs,
# sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://langparkerenschiphol.nl

# MyParkingPro instance origin. Also the only host allowed by the
# frame-src directive of the CSP in next.config.ts.
NEXT_PUBLIC_PARKINGPRO_ORIGIN=https://langparkerenschiphol.myparking.pro

# Google Search Console verification token (optional; omit in preview).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# GA4 measurement ID (optional). When empty, no analytics script is emitted.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Contact form delivery ───────────────────────────────────────────────────
# Server-only. Never prefix these with NEXT_PUBLIC_: an e-mail API key in the
# client bundle is an open relay for anyone who views source.
#
# Set EITHER a Resend key (preferred) OR a forwarding webhook. With neither, the
# form tells the visitor plainly that it could not send and hands them a
# prefilled mailto: link — it never claims a message was delivered when it was
# not. See src/app/(site)/contact/actions.ts.

# Resend API key. The CONTACT_FROM domain must be verified in Resend.
RESEND_API_KEY=
# Defaults to website@langparkerenschiphol.nl
CONTACT_FROM=
# Defaults to the canonical address in src/config/site.ts
CONTACT_TO=

# Alternative to Resend: any endpoint that accepts a JSON POST (Zapier, Make,
# Formspree, a script on the client's own hosting).
CONTACT_FORWARD_URL=
